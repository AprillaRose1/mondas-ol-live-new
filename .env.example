# mondas-front — LOCAL DEVELOPMENT (copy to .env.local, which is git-ignored)
# NEXT_PUBLIC_* vars are baked into the bundle at BUILD time.

# Backend API base URL (the NestJS API)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Stripe Elements publishable key — unset → checkout uses the non-card mock flow
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# WhatsApp click-to-chat (country code + number, digits only). Example Tunisia: 21678000000
NEXT_PUBLIC_WHATSAPP_NUMBER=21678000000

# Used by Next.js middleware to verify the JWT cookie issued by the backend.
# Must match the backend's JWT_SECRET.
JWT_SECRET=dev_secret_replace_in_production_must_be_at_least_32_chars

# ── Payments (Stripe test) ─────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ── Payments (PayPal sandbox) ──────────────────────────
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx
NEXT_PUBLIC_PAYPAL_CLIENT_ID=xxx

# ── Order email (Gmail app password now; provider-agnostic) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
ORDER_EMAIL_TO=orders@example.com
ORDER_EMAIL_FROM="Mondas <orders@example.com>"
